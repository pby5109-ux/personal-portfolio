# ==========================================================
# 环境变量模板：复制为 .env.local 后填写
# ==========================================================

# —— Supabase（用于「文件 & 简历」板块的上传 / 托管）——
# 在 https://supabase.com 创建项目后，从 Project Settings → API 中获取
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# —— 上传功能密码（仅前端校验，用于防止随意上传）——
# 不配置时默认为 admin123，请务必修改！
NEXT_PUBLIC_UPLOAD_PASSWORD=admin123

# —— 联系表单（可选）——
# 推荐使用 https://formspree.io 免费创建一个表单端点，把地址填到这里。
# 不配置时，表单提交会进行「模拟成功」演示。
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# —— 访问统计（可选）——
# 使用 Umami 时填写脚本地址与网站 ID，然后在 layout.tsx 中打开对应注释
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
